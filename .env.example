# ──────────────────────────────────────────
# VeloXML — Variáveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env
# ──────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=postgres123

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_AT_LEAST_32_CHARS!

# MinIO (S3)
MINIO_ACCESS_KEY=veloxml
MINIO_SECRET_KEY=veloxml123

# PgAdmin
PGADMIN_EMAIL=admin@veloxml.com.br
PGADMIN_PASSWORD=admin123

# Hangfire Dashboard (/hangfire) — Basic Auth, sem isso o dashboard fica bloqueado (fail-closed)
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Amazon S3 — só usado em produção (STORAGE_PROVIDER=S3). Sem essas variáveis, o sistema
# continua usando o MinIO normalmente (comportamento padrão, sem mudança nenhuma).
STORAGE_PROVIDER=Minio
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=sa-east-1
