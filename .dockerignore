**/.git
# O build do frontend precisa do .git da raiz pra calcular a versão automática (número de
# commits) dentro do container — sem essa exceção, "**/.git" acima excluía até o .git raiz do
# contexto de build, o script de versão nunca achava o git e a versão ficava travada no valor
# commitado por último, mesmo com deploys novos.
!/.git
**/.vs
**/.vscode
**/.idea

# .NET build artifacts (contain Windows-specific paths from local restore)
**/obj/
**/bin/

# Node modules
**/node_modules/

# Angular dist
src/Frontend/dist/

# Test projects
src/Backend/VeloXML.Tests.Unit/

# Logs
logs/
*.log

# Env
.env

# Docker
docker-compose.override.yml
